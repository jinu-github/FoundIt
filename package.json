{
  "name": "foundit",
  "version": "0.1.0",
  "description": "A private, local-first library for images, links, text, and notes",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "predev": "npm run prepare:ocr",
    "prebuild": "npm run prepare:ocr"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@zip.js/zip.js": "2.24.0",
    "dexie": "^4.4.7",
    "minisearch": "7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "7.0.0"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
